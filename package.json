{
  "name": "isotopus",
  "version": "0.2.1",
  "private": true,
  "author": {
    "name": "Local Build",
    "email": "local@localhost"
  },
  "desktopName": "com.isotopus.musicplayer",
  "description": "Player local de música com playlists e letras sincronizadas, incluindo alinhamento automático",
  "homepage": "https://github.com/mrts-wx/isotopus",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/patch-transformers-electron.js && electron .",
    "test": "node --test",
    "build:ubuntu": "node scripts/patch-transformers-electron.js && electron-builder --linux deb",
    "build:debian": "node scripts/patch-transformers-electron.js && electron-builder --linux deb",
    "build:arch": "node scripts/patch-transformers-electron.js && electron-builder --linux pacman",
    "build:windows": "node scripts/patch-transformers-electron.js && electron-builder --win nsis"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "music-metadata": "^11.13.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.isotopus.musicplayer",
    "productName": "Isótopus",
    "extraResources": [
      {
        "from": "lyrics-worker.cjs",
        "to": "lyrics-worker.cjs"
      }
    ],
    "files": [
      "main.js",
      "sharp-stub.mjs",
      "preload.js",
      "server.js",
      "flac.js",
      "library.js",
      "playlist.js",
      "shuffle.js",
      "lyrics.js",
      "index.html",
      "app.js",
      "styles.css",
      "theme.css",
      "motion.css",
      "local.css",
      "polish.css",
      "clarity.css",
      "lyrics.css",
      "features.css",
      "home-player.css",
      "no-cover.svg",
      "build/icons/**",
      "README.md",
      "package.json",
      "node_modules/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/sharp-*/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/x64/libonnxruntime_providers_cuda.so",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/x64/libonnxruntime_providers_tensorrt.so"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icons",
      "syncDesktopName": true,
      "artifactName": "Isotopus-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/isotopus.ico",
      "artifactName": "Isotopus-${version}-setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Isótopus"
    },
    "deb": {
      "packageCategory": "sound",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "electron@45.3.2": true
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
